# Firebase web config (safe to expose in client; restrict by authorized domains)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# Groq + Qwen — required for /decide adaptive questions + decision maps
# ---------------------------------------------------------------------------
# Server-only. Do NOT prefix with VITE_ (would leak to the browser).
# Paste into .env.local, then FULLY restart `npm run dev` (env loads at server boot).
# vite.config copies non-VITE keys onto process.env for TanStack server functions.
GROQ_API_KEY=
# Optional: stored if you use a separate Qwen provider later. Groq calls use GROQ_API_KEY only.
# QWEN_API_KEY=
# Live Qwen on Groq (inspected via /openai/v1/models). Change without code edits:
GROQ_MODEL=qwen/qwen3.6-27b
# If you see "AI is not configured" after setting the key → restart the dev server.

# ---------------------------------------------------------------------------
# Paddle Billing — ONE-TIME Pro/Premium purchases (NOT subscriptions)
# ---------------------------------------------------------------------------

# Client (Vite) — public client-side token + price IDs only. Never put secrets here.
VITE_PADDLE_CLIENT_TOKEN=
VITE_PADDLE_PRO_PRICE_ID=
VITE_PADDLE_PREMIUM_PRICE_ID=
VITE_PADDLE_ENV=sandbox

# Server-only (webhook + optional Admin). Never prefix with VITE_.
PADDLE_WEBHOOK_SECRET=
PADDLE_ENV=sandbox
# Optional mirrors if you prefer non-VITE names on the server:
# PADDLE_PRO_PRICE_ID=
# PADDLE_PREMIUM_PRICE_ID=
# Only needed if you call Paddle REST API from the server (not required for checkout + webhooks):
# PADDLE_API_KEY=

# Firebase Admin — required for webhook to write plan ownership to Firestore.
# Paste the full service account JSON as a single line (escape newlines as \n in private_key).
FIREBASE_SERVICE_ACCOUNT_JSON=
